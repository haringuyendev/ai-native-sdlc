{
  "ai-native-sdlc": {
    "SessionStart": [
      { "type": "command", "command": "node hooks/run.mjs --agent agy --event session-start" }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "node hooks/run.mjs --agent agy --event pre-bash" }]
      },
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [{ "type": "command", "command": "node hooks/run.mjs --agent agy --event pre-edit" }]
      }
    ],
    "Stop": [
      { "type": "command", "command": "node hooks/run.mjs --agent agy --event stop" }
    ]
  }
}
